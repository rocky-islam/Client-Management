# Database - Neon PostgreSQL connection string (pooled recommended for serverless)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct connection for migrations if using PgBouncer
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Session Secret (Generate with: openssl rand -base64 32)
AUTH_SECRET="your-super-secret-key-min-32-chars-long-rocky-business-manager"

# Initial Admin Seed Credentials
INITIAL_ADMIN_EMAIL="admin@rockybusiness.com"
INITIAL_ADMIN_PASSWORD="AdminPassword123!"
INITIAL_ADMIN_NAME="Rocky Freelancer"

# Application Settings
NEXT_PUBLIC_APP_NAME="Rocky Business Manager"
NEXT_PUBLIC_DEFAULT_CURRENCY="USD"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Dhaka"

